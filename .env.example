# Copy to .env (never commit .env).
# `npm run db:setup -- "<postgres password>"` creates this database and fills the line below in for you.
DATABASE_URL=postgres://verola:verola_dev_password@localhost:5432/verola
# If you use Docker instead (docker compose up -d), the database is on port 5433:
# DATABASE_URL=postgres://verola:verola_dev_password@localhost:5433/verola

# Where private verification documents are stored on disk (relative to the project folder).
STORAGE_DIR=./storage

# The account that `npm run db:admin` is meant for. Public sign-up cannot use this email.
ADMIN_EMAIL=admin@ddlxapparel.com

# Optional: public address used in password-reset links (defaults to the request address).
# APP_URL=http://localhost:8080
