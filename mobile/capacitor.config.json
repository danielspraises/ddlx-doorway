{
  "appId": "shop.ddlx.vendorhub",
  "appName": "DDLX Vendor Hub",
  "webDir": "www",
  "server": {
    "url": "https://vendor.ddlx.shop",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": ["vendor.ddlx.shop"]
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#fbfbf8",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
